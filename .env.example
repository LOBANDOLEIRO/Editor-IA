# Chave da API do Claude (https://platform.claude.com). Sem ela, o editor
# funciona só com templates (sem gerar vídeos com IA).
ANTHROPIC_API_KEY=

# Modelos usados pela IA. Padrão: claude-opus-5-5 (melhor qualidade).
# Para baixar o custo: criar com claude-sonnet-5-5 e ajustar com claude-haiku-5-5.
AI_MODEL_CREATE=claude-opus-5-5
AI_MODEL_EDIT=claude-opus-5-5

# Login e banco de dados (Supabase). Sem estas duas, o app roda em modo local:
# sem login, plano de DEFAULT_PLAN e uso salvo em .data/usage.json.
# Valores em Project Settings > API Keys do seu projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Só no modo local (sem Supabase): plano de todos os visitantes. gratis | criador | pro
DEFAULT_PLAN=gratis

# Renderização no servidor (precisa de FFmpeg instalado).
# Qualidade: draft | standard | high
RENDER_QUALITY=standard
# Opcional: caminho de um Chrome/Chromium já instalado.
# HYPERFRAMES_BROWSER_PATH=/usr/bin/chromium
